package com.rhm.rhm_mobile

import android.app.ActivityManager
import android.app.Notification
import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.PendingIntent
import android.app.Service
import android.content.Context
import android.content.Intent
import android.content.pm.PackageManager
import android.content.pm.ServiceInfo
import android.os.Build
import android.os.IBinder
import org.json.JSONObject
import java.net.HttpURLConnection
import java.net.URL
import java.util.concurrent.Executors
import java.util.concurrent.ScheduledFuture
import java.util.concurrent.TimeUnit

class RhmRuntimeService : Service() {
    companion object {
        const val ACTION_STOP = "com.rhm.rhm_mobile.aps.STOP"
        private const val ACTION_START = "com.rhm.rhm_mobile.aps.START"
        private const val CHANNEL_ID = "rhm_local_server_monitor"
        private const val NOTIFICATION_ID = 8102
        private const val PREFS = "rhm_android_runtime"
        private const val PREF_AUTOSTART = "autostart_after_boot"
        private const val PREF_BACKEND_AUTOSTART = "backend_autostart_after_boot"
        private const val PREF_API_HEALTH_STATE = "api_health_state"
        private const val PREF_API_REACHABLE = "api_port_reachable"
        private const val PREF_LAST_CHECK = "last_api_check_at"
        private const val PREF_LAST_ERROR = "last_monitor_error"
        private const val PREF_RECOVERY_ATTEMPTS = "recovery_attempts"
        private const val PREF_LAST_RECOVERY_AT = "last_recovery_at"
        private const val PREF_LAST_RECOVERY_ACTION = "last_recovery_action"
        private const val PREF_EVER_HEALTHY = "api_ever_healthy"

        fun start(context: Context) {
            val intent = Intent(context, RhmRuntimeService::class.java).setAction(ACTION_START)
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) context.startForegroundService(intent)
            else context.startService(intent)
        }

        fun stop(context: Context) {
            context.stopService(Intent(context, RhmRuntimeService::class.java))
        }

        fun setAutostartEnabled(context: Context, enabled: Boolean) {
            preferences(context).edit().putBoolean(PREF_AUTOSTART, enabled).apply()
        }

        fun setBackendAutostartEnabled(context: Context, enabled: Boolean) {
            preferences(context).edit().putBoolean(PREF_BACKEND_AUTOSTART, enabled).apply()
        }

        fun runBackendCommand(context: Context, action: String) {
            RhmTermuxRuntimeController.execute(context, action)
        }

        private fun preferences(context: Context) =
            context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)

        fun getSnapshot(context: Context): Map<String, Any> {
            val activityManager = context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
            @Suppress("DEPRECATION")
            val running = activityManager.getRunningServices(Int.MAX_VALUE).any {
                it.service.className == RhmRuntimeService::class.java.name
            }
            val prefs = preferences(context)
            val notificationPermissionGranted =
                Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU ||
                    context.checkSelfPermission(android.Manifest.permission.POST_NOTIFICATIONS) ==
                    PackageManager.PERMISSION_GRANTED
            val healthState = prefs.getString(PREF_API_HEALTH_STATE, "unknown") ?: "unknown"
            return mapOf(
                "supported" to true,
                "managerRunning" to running,
                "autostartEnabled" to prefs.getBoolean(PREF_AUTOSTART, false),
                "backendAutostartEnabled" to prefs.getBoolean(PREF_BACKEND_AUTOSTART, false),
                "notificationPermissionGranted" to notificationPermissionGranted,
                "termuxInstalled" to RhmTermuxRuntimeController.isInstalled(context),
                "termuxPermissionGranted" to RhmTermuxRuntimeController.hasRunCommandPermission(context),
                "apiHealthy" to (healthState == "healthy"),
                "apiHealthState" to healthState,
                "apiPortReachable" to (healthState == "healthy"),
                "lastApiCheckAt" to prefs.getLong(PREF_LAST_CHECK, 0L),
                "lastError" to (prefs.getString(PREF_LAST_ERROR, "") ?: ""),
                "recoveryAttempts" to prefs.getInt(PREF_RECOVERY_ATTEMPTS, 0),
                "lastRecoveryAt" to prefs.getLong(PREF_LAST_RECOVERY_AT, 0L),
                "lastRecoveryAction" to (prefs.getString(PREF_LAST_RECOVERY_ACTION, "") ?: "")
            )
        }
    }

    private val monitorExecutor = Executors.newSingleThreadScheduledExecutor()
    private var monitorTask: ScheduledFuture<*>? = null
    private var consecutiveUnavailableChecks = 0
    private var recoveryInProgress = false

    override fun onCreate() {
        super.onCreate()
        createNotificationChannel()
    }

    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
        if (intent?.action == ACTION_STOP) {
            stopSelf(startId)
            return START_NOT_STICKY
        }
        try {
            val prefs = getSharedPreferences(PREFS, Context.MODE_PRIVATE)
            promoteToForeground(
                buildNotification(prefs.getString(PREF_API_HEALTH_STATE, "unknown") ?: "unknown")
            )
            startMonitoring()
            if (prefs.getBoolean(PREF_BACKEND_AUTOSTART, false)) {
                requestBackendCommand("start", prefs, "backend_start_failed")
            }
        } catch (_: Exception) {
            getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit()
                .putString(PREF_LAST_ERROR, "foreground_service_error").apply()
            stopSelf(startId)
            return START_NOT_STICKY
        }
        return START_STICKY
    }

    private fun promoteToForeground(notification: Notification) {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.UPSIDE_DOWN_CAKE) {
            startForeground(
                NOTIFICATION_ID,
                notification,
                ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE
            )
        } else {
            startForeground(NOTIFICATION_ID, notification)
        }
    }

    private fun startMonitoring() {
        if (monitorTask != null) return
        monitorTask = monitorExecutor.scheduleWithFixedDelay(
            { runHealthCheckSafely() },
            10,
            20,
            TimeUnit.SECONDS
        )
    }

    private fun runHealthCheckSafely() {
        val prefs = getSharedPreferences(PREFS, Context.MODE_PRIVATE)
        val healthState = try {
            authenticatedFastApiHealth()
        } catch (_: Exception) {
            "unavailable"
        }

        prefs.edit()
            .putString(PREF_API_HEALTH_STATE, healthState)
            .putBoolean(PREF_API_REACHABLE, healthState == "healthy")
            .putLong(PREF_LAST_CHECK, System.currentTimeMillis())
            .apply()

        when (healthState) {
            "healthy" -> {
                consecutiveUnavailableChecks = 0
                prefs.edit()
                    .putBoolean(PREF_EVER_HEALTHY, true)
                    .putInt(PREF_RECOVERY_ATTEMPTS, 0)
                    .putString(PREF_LAST_ERROR, "")
                    .apply()
            }
            "unavailable" -> {
                consecutiveUnavailableChecks += 1
                prefs.edit().putString(PREF_LAST_ERROR, "fastapi_unavailable").apply()
                maybeRecoverBackend(prefs)
            }
            "unauthorized" -> {
                consecutiveUnavailableChecks = 0
                prefs.edit().putString(PREF_LAST_ERROR, "fastapi_unauthorized").apply()
            }
            "token_missing" -> {
                consecutiveUnavailableChecks = 0
                prefs.edit().putString(PREF_LAST_ERROR, "health_token_missing").apply()
            }
            else -> {
                consecutiveUnavailableChecks = 0
                prefs.edit().putString(PREF_LAST_ERROR, "fastapi_invalid_health_response").apply()
            }
        }

        val currentState = prefs.getString(PREF_API_HEALTH_STATE, "unknown") ?: "unknown"
        val manager = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
        manager.notify(NOTIFICATION_ID, buildNotification(currentState))
    }

    private fun maybeRecoverBackend(prefs: android.content.SharedPreferences) {
        if (!prefs.getBoolean(PREF_BACKEND_AUTOSTART, false) || recoveryInProgress) return

        val everHealthy = prefs.getBoolean(PREF_EVER_HEALTHY, false)
        val requiredFailures = if (everHealthy) 2 else 5
        if (consecutiveUnavailableChecks < requiredFailures) return

        val attempts = prefs.getInt(PREF_RECOVERY_ATTEMPTS, 0)
        val delayMs = when (attempts) {
            0 -> 30_000L
            1 -> 60_000L
            2 -> 120_000L
            else -> 300_000L
        }
        val now = System.currentTimeMillis()
        val lastRecoveryAt = prefs.getLong(PREF_LAST_RECOVERY_AT, 0L)
        if (now - lastRecoveryAt < delayMs) return

        val action = "restart"
        recoveryInProgress = true
        prefs.edit()
            .putLong(PREF_LAST_RECOVERY_AT, now)
            .putInt(PREF_RECOVERY_ATTEMPTS, attempts + 1)
            .putString(PREF_LAST_RECOVERY_ACTION, action)
            .putString(PREF_LAST_ERROR, "backend_recovery_requested")
            .apply()

        try {
            RhmTermuxRuntimeController.execute(applicationContext, action)
        } catch (_: Exception) {
            prefs.edit().putString(PREF_LAST_ERROR, "termux_recovery_failed").apply()
        } finally {
            recoveryInProgress = false
        }
    }

    private fun requestBackendCommand(
        action: String,
        prefs: android.content.SharedPreferences,
        errorCode: String
    ) {
        try {
            RhmTermuxRuntimeController.execute(applicationContext, action)
            prefs.edit().putString(PREF_LAST_ERROR, "").apply()
        } catch (_: Exception) {
            prefs.edit().putString(PREF_LAST_ERROR, errorCode).apply()
        }
    }

    private fun authenticatedFastApiHealth(): String {
        val token = RhmHealthTokenStore.read(this) ?: return "token_missing"
        var connection: HttpURLConnection? = null
        return try {
            connection = URL("http://127.0.0.1:8000/mobile/health").openConnection() as HttpURLConnection
            connection.requestMethod = "GET"
            connection.connectTimeout = 1800
            connection.readTimeout = 1800
            connection.instanceFollowRedirects = false
            connection.setRequestProperty("Authorization", "Bearer $token")
            connection.setRequestProperty("Accept", "application/json")
            val code = connection.responseCode
            if (code == HttpURLConnection.HTTP_UNAUTHORIZED || code == HttpURLConnection.HTTP_FORBIDDEN) {
                "unauthorized"
            } else if (code != HttpURLConnection.HTTP_OK) {
                "unavailable"
            } else {
                val body = connection.inputStream.bufferedReader(Charsets.UTF_8).use { it.readText() }
                val payload = JSONObject(body)
                if (
                    payload.optString("status") == "ok" &&
                    payload.optString("transport") == "loopback"
                ) "healthy" else "invalid_response"
            }
        } catch (_: Exception) {
            "unavailable"
        } finally {
            connection?.disconnect()
        }
    }

    private fun createNotificationChannel() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            val channel = NotificationChannel(
                CHANNEL_ID,
                "مراقبة خادم RHM المحلي",
                NotificationManager.IMPORTANCE_LOW
            ).apply {
                description = "يعرض نتيجة فحص FastAPI المحلي مع المصادقة والتعافي التلقائي."
                setShowBadge(false)
            }
            val manager = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
            manager.createNotificationChannel(channel)
        }
    }

    private fun buildNotification(healthState: String): Notification {
        val openAppPendingIntent = PendingIntent.getActivity(
            this, 8102, Intent(this, MainActivity::class.java),
            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
        )
        val stopPendingIntent = PendingIntent.getService(
            this, 8103, Intent(this, RhmRuntimeService::class.java).setAction(ACTION_STOP),
            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
        )
        val text = when (healthState) {
            "healthy" -> "FastAPI جاهز: فحص المصادقة ناجح."
            "unauthorized" -> "FastAPI رفض رمز الوصول المحفوظ."
            "token_missing" -> "بانتظار مزامنة رمز الوصول الآمن."
            "invalid_response" -> "استجابة فحص FastAPI غير صالحة."
            else -> "FastAPI غير متاح؛ خدمة RHM تراقبه وتحاول استعادته."
        }
        val builder = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            Notification.Builder(this, CHANNEL_ID)
        } else {
            Notification.Builder(this)
        }
        return builder
            .setSmallIcon(android.R.drawable.ic_menu_info_details)
            .setContentTitle("RHM — مراقبة FastAPI المحلية")
            .setContentText(text)
            .setStyle(
                Notification.BigTextStyle().bigText(
                    "$text الفحص كل 20 ثانية عبر GET /mobile/health مع Bearer token. " +
                        "لا يثبت هذا وحده جاهزية PostgreSQL أو مزوّد النماذج."
                )
            )
            .setContentIntent(openAppPendingIntent)
            .setCategory(Notification.CATEGORY_SERVICE)
            .setPriority(Notification.PRIORITY_LOW)
            .setOngoing(true)
            .setOnlyAlertOnce(true)
            .addAction(Notification.Action.Builder(null, "إيقاف", stopPendingIntent).build())
            .build()
    }

    override fun onDestroy() {
        monitorTask?.cancel(true)
        monitorTask = null
        monitorExecutor.shutdownNow()
        super.onDestroy()
    }

    override fun onBind(intent: Intent?): IBinder? = null
}
