package com.rhm.rhm_mobile

import android.Manifest
import android.content.Intent
import android.content.pm.PackageManager
import android.net.Uri
import android.os.Build
import android.provider.Settings
import io.flutter.embedding.android.FlutterActivity
import io.flutter.embedding.engine.FlutterEngine
import io.flutter.plugin.common.MethodChannel

class MainActivity : FlutterActivity() {
    companion object {
        private const val CHANNEL = "com.rhm.rhm_mobile/aps_runtime"
    }

    override fun configureFlutterEngine(flutterEngine: FlutterEngine) {
        super.configureFlutterEngine(flutterEngine)

        MethodChannel(flutterEngine.dartExecutor.binaryMessenger, CHANNEL)
            .setMethodCallHandler { call, result ->
                when (call.method) {
                    "getStatus" -> result.success(RhmRuntimeService.getSnapshot(this))

                    "setHealthToken" -> {
                        val token = call.arguments as? String
                        if (token.isNullOrBlank() || !Regex("^[A-Za-z0-9_-]{32,}$").matches(token)) {
                            result.error("invalid_health_token", "رمز الوصول غير صالح.", null)
                        } else {
                            try {
                                RhmHealthTokenStore.save(this, token)
                                result.success(null)
                            } catch (_: Exception) {
                                result.error("health_token_store_failed", "تعذر حفظ رمز فحص صحة FastAPI في Android Keystore.", null)
                            }
                        }
                    }

                    "startBackend" -> runTermuxAction("start", result)
                    "stopBackend" -> runTermuxAction("stop", result)
                    "restartBackend" -> runTermuxAction("restart", result)

                    "setBackendAutostartEnabled" -> {
                        val enabled = call.arguments as? Boolean
                        if (enabled == null) {
                            result.error("invalid_argument", "قيمة التشغيل التلقائي للخادم غير صالحة.", null)
                        } else if (enabled && !hasNotificationPermission()) {
                            result.error("notifications_permission_required", "امنح إذن الإشعارات قبل تشغيل الخادم تلقائياً.", null)
                        } else if (enabled && (!RhmTermuxRuntimeController.isInstalled(this) ||
                                                   !RhmTermuxRuntimeController.hasRunCommandPermission(this))) {
                            result.error("termux_permission_required", "ثبّت Termux وامنح RHM إذن RUN_COMMAND أولاً.", null)
                        } else {
                            RhmRuntimeService.setBackendAutostartEnabled(this, enabled)
                            if (enabled) {
                                try {
                                    RhmRuntimeService.start(this, startBackend = true)
                                } catch (error: Exception) {
                                    result.error("service_start_failed", error.message, null)
                                    return@setMethodCallHandler
                                }
                            }
                            result.success(null)
                        }
                    }

                    "openTermuxSettings" -> {
                        try {
                            startActivity(
                                Intent(
                                    Settings.ACTION_APPLICATION_DETAILS_SETTINGS,
                                    Uri.parse("package:com.termux")
                                )
                            )
                            result.success(null)
                        } catch (_: Exception) {
                            result.error("termux_not_installed", "تعذر فتح إعدادات Termux. تحقق من تثبيته أولاً.", null)
                        }
                    }

                    "startManager" -> {
                        if (!hasNotificationPermission()) {
                            result.error(
                                "notifications_permission_required",
                                "امنح RHM إذن الإشعارات أولاً حتى تظهر حالة الخدمة.",
                                null
                            )
                        } else {
                            try {
                                RhmRuntimeService.start(this)
                                result.success(null)
                            } catch (error: Exception) {
                                result.error(
                                    "service_start_failed",
                                    error.message ?: "تعذر تشغيل خدمة مراقبة RHM.",
                                    null
                                )
                            }
                        }
                    }

                    "stopManager" -> {
                        RhmRuntimeService.stop(this)
                        result.success(null)
                    }

                    "setAutostartEnabled" -> {
                        val enabled = call.arguments as? Boolean
                        if (enabled == null) {
                            result.error("invalid_argument", "قيمة التشغيل التلقائي غير صالحة.", null)
                        } else if (enabled && !hasNotificationPermission()) {
                            result.error(
                                "notifications_permission_required",
                                "امنح إذن الإشعارات قبل تفعيل التشغيل التلقائي.",
                                null
                            )
                        } else {
                            RhmRuntimeService.setAutostartEnabled(this, enabled)
                            result.success(null)
                        }
                    }

                    "openNotificationSettings" -> {
                        try {
                            val settingsIntent = Intent(Settings.ACTION_APP_NOTIFICATION_SETTINGS)
                                .putExtra(Settings.EXTRA_APP_PACKAGE, packageName)
                            startActivity(settingsIntent)
                            result.success(null)
                        } catch (_: Exception) {
                            val fallback = Intent(
                                Settings.ACTION_APPLICATION_DETAILS_SETTINGS,
                                Uri.parse("package:$packageName")
                            )
                            startActivity(fallback)
                            result.success(null)
                        }
                    }

                    else -> result.notImplemented()
                }
            }
    }

    private fun runTermuxAction(action: String, result: MethodChannel.Result) {
        try {
            if (action == "stop") {
                RhmRuntimeService.setBackendAutostartEnabled(this, false)
            } else {
                RhmRuntimeService.start(this, startBackend = false)
            }
            RhmRuntimeService.runBackendCommand(this, action)
            result.success(mapOf("accepted" to true, "action" to action))
        } catch (error: SecurityException) {
            result.error("termux_permission_required", error.message, null)
        } catch (error: IllegalStateException) {
            result.error("termux_not_ready", error.message, null)
        } catch (_: Exception) {
            result.error("termux_command_failed", "تعذر إرسال أمر إدارة Backend إلى Termux.", null)
        }
    }

    private fun hasNotificationPermission(): Boolean {
        return Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU ||
            checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS) ==
            PackageManager.PERMISSION_GRANTED
    }
}
